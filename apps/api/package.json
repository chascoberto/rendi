{
  "name": "@rendi/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/seed/index.ts --reset",
    "db:studio": "drizzle-kit studio",
    "user:create": "tsx --env-file-if-exists=.env src/cli/users.ts create",
    "user:passwd": "tsx --env-file-if-exists=.env src/cli/users.ts passwd",
    "user:list": "tsx --env-file-if-exists=.env src/cli/users.ts list"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@node-rs/argon2": "^2.2.1",
    "@rendi/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  }
}
