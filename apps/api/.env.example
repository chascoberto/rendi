# Copia este archivo a .env y ajusta los valores.
# Desarrollo: los valores de abajo sirven tal cual.
# Producción (servidor): NODE_ENV=production y revisar la sección del final.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Ruta del archivo SQLite (se crea si no existe).
DATABASE_PATH=./data/rendi.db
# Carpeta de migraciones SQL (relativa al directorio de trabajo).
MIGRATIONS_DIR=./drizzle
# Consultar Open Food Facts al escanear un código desconocido (true/false).
OPEN_FOOD_FACTS=true

# --- Producción ---
# Con NODE_ENV=production:
# - la cookie de sesión exige HTTPS (COOKIE_SECURE=true por defecto; tailscale serve lo entrega),
# - la API sirve también la app compilada desde WEB_DIST_DIR (por defecto ../web/dist),
# - antes de aplicar migraciones se guarda data/pre-migration-<fecha>.db.
# HOST=127.0.0.1 basta con tailscale serve: nada queda expuesto a la red local.
# COOKIE_SECURE=true
# WEB_DIST_DIR=../web/dist
